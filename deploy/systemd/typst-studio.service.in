# typst-studio の user unit テンプレート（spec 7.1）。
# scripts/install-unit.sh が @APP_DIR@ / @NODE@ を置き換えて typst-studio.service を作る。
# このファイルには絶対パス・ホスト名を書かない。
[Unit]
Description=typst-studio

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
ExecStart=@NODE@ @APP_DIR@/server/dist/main.js
Restart=on-failure
RestartSec=5
# 停止時は watchdog / none ドライバで起動した子（tinymist / typst）も止める。
# systemd-scope ドライバの子は別の scope で動き、studio の停止処理で止める
KillMode=control-group
# studio が異常終了しても systemd-scope ドライバの子（typst-studio-*.scope）を残さない
ExecStopPost=-systemctl --user stop typst-studio-*.scope

[Install]
WantedBy=default.target
